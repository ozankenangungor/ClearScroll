{
  "manifest_version": 3,
  "name": "IdeaBlocker",
  "version": "0.2.0",
  "description": "On-device AI semantic filter — blurs any topic you choose using WebGPU-accelerated sentence embeddings.",
  "minimum_chrome_version": "113",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "brain.worker.js",
        "pkg/text_classifier_wasm.js",
        "pkg/text_classifier_wasm_bg.wasm"
      ],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
