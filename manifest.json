{
  "manifest_version": 3,
  "name": "IdeaBlocker",
  "version": "0.2.0",
  "description": "On-device AI semantic filter — blurs any topic you choose using WebGPU-accelerated sentence embeddings.",
  "permissions": ["activeTab", "storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extractor.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "brain.worker.js",
        "pkg/text_classifier_wasm.js",
        "pkg/text_classifier_wasm_bg.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
