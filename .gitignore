# Build outputs
/target/
# pkg/ is generated by npm run build:wasm, except the hand-written type
# declarations, which typecheck needs on a clean checkout.
/pkg/*
!/pkg/clearscroll_engine.d.ts
/dist/
/build/
/release/

# Private evaluation data (third-party page text; see eval/realworld/README.md)
/eval/private/

# Local environments
/.venv/
node_modules/
__pycache__/
*.pyc

# Model artifacts are generated by `npm run setup:model` (pinned + verified)
model/*.bin
model/*.onnx

# Extension packaging secrets
*.crx
*.pem

# Editor / tool state
/.claude/
.DS_Store
**/*.rs.bk
test-results/
